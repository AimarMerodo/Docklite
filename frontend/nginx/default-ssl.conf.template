# HTTPS template — used when DockLite is deployed with a custom domain.
#
# install.sh substitutes ${SERVER_NAME} (with envsubst) and mounts the
# resulting file as /etc/nginx/conf.d/default.conf on top of the baked-in
# HTTP-only config. Certs are expected at /etc/nginx/certs/live/${SERVER_NAME}/
# (Let's Encrypt layout, mounted by docker-compose from the host).

# 1) Plain HTTP — redirect everything to HTTPS, except the ACME challenge
#    so certbot can renew certificates.
server {
    listen 80;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2) HTTPS — serve the SPA + reverse-proxy /api/ to the backend.
server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/${SERVER_NAME}/privkey.pem;

    # Modern intermediate config (Mozilla Aug 2025 baseline)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to backend
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        # $http_host (not $host) — keeps the port (e.g. custom HTTPS port), so
        # the backend rebuilds the exact browser origin and CORS stays quiet.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
