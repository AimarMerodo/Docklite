# ──────────────────────────────────────────────────────────────
# DockLite — example configuration
#
# Copy to ".env" and fill in real values. The install.sh script
# generates this automatically by asking the server admin.
#
# In production the only services published to the host are
# the frontend (HTTP/HTTPS). Backend and DB are internal-only
# inside the docker-compose network — they never collide with
# anything else the server is running.
# ──────────────────────────────────────────────────────────────


# --- HOST PORTS (only frontend is published) ---
# Change if 80 / 443 are already in use on the server.
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443


# --- POSTGRES ---
# Used by the postgres container AND injected into the backend
# (docker-compose builds SPRING_DATASOURCE_* from these).
POSTGRES_DB=docklite
POSTGRES_USER=docklite
POSTGRES_PASSWORD=changeme


# --- BACKEND ---

# JWT signing secret. MUST be at least 48 characters (HS384 needs >=384 bits).
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-48-chars


# --- BOOTSTRAP ADMIN ---
# Created automatically on first startup if it doesn't exist (idempotent).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@docklite.local
ADMIN_PASSWORD=change-me-on-first-login


# --- PUBLIC URL ---
# Used to build invitation links shown to the admin in the response.
# Set to your real domain (https://docklite.example.com) or http://<public-ip>.
APP_PUBLIC_URL=http://localhost


# --- DOCKER DAEMON ---
# Default (unset / Linux production) uses the unix socket: unix:///var/run/docker.sock
# Override for local dev:
#   Windows + Docker Desktop:  DOCKER_HOST=npipe:////./pipe/docker_engine
#   Mac:                       DOCKER_HOST=unix:///var/run/docker.sock  (default, redundant)
# DOCKER_HOST=

# --- Modo demo (solo para el deployment de demo publica; las instalaciones normales no lo necesitan) ---
# DEMO_MODE=true
# ATENCION: DEMO_MODE=true deshabilita TODAS las cuentas salvo la del usuario demo (kiosco). No lo actives en una instalacion real.
